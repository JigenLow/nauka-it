    while c0 !=1:
        if c0%2==0:
            c0 = c0/2
            kroki = kroki +1
            print("Liczba była parzysta, nowa wartość to:",c0)
        elif c0%2!=0:  
            print("Wartość liczby to:", c0)
            c0 = 3 * c0 +1
            print("Wartość liczby po operacji:", c0)
            kroki = kroki +1
        
print("Liczba kroków wynosiła :", kroki)


